{
  "name": "brainz-group-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "storybook": "npm run dev -w @workspace/storybook"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
